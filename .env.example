ANTHROPIC_API_KEY=
FA_API_TOKEN=
PORT=3000

# ── Instagram (Meta) ──────────────────────────────────────────────
# Token de verificación que vos inventás y también pegás en Meta > Webhooks
IG_VERIFY_TOKEN=
# Token de acceso de la página/Instagram (Meta > Generar token de acceso)
IG_ACCESS_TOKEN=
# App Secret (Meta > Configuración de la app > Básica) — valida la firma de los webhooks
IG_APP_SECRET=
# Base de la Graph API (dejar por defecto salvo que Meta indique graph.instagram.com)
IG_GRAPH_BASE=https://graph.facebook.com/v21.0
# Franja horaria en la que el bot contesta en Instagram (resto del día contesta Patricia)
IG_TZ=America/New_York
IG_BOT_START_HOUR=23
IG_BOT_END_HOUR=7
# Interruptores: IG_ENABLED=false apaga el bot de Instagram; IG_SEND_IMAGES=false no manda fotos
IG_ENABLED=true
IG_SEND_IMAGES=true
# ── Ritmo de envío (evitar que Meta lo marque como spam) ──────────
# Pausa media entre mensajes y variación aleatoria alrededor de esa media.
# Con 3500/1200 cada mensaje sale entre 2,3s y 4,7s después del anterior.
IG_MSG_DELAY_MS=3500
IG_MSG_JITTER_MS=1200
# Indicador de "escribiendo…" entre mensajes (IG_TYPING=false lo desactiva)
IG_TYPING=true
# ── Agrupado de mensajes ──────────────────────────────────────────
# La gente manda la consulta partida en varios mensajes con segundos de
# diferencia y sin esto el bot contesta una vez por cada uno, repitiendo lo
# mismo. Cada mensaje nuevo reinicia la espera: el bot contesta cuando pasan
# IG_DEBOUNCE_MS sin que escriba nada más. Más alto agrupa mejor pero tarda más
# en contestar; 20 s se siente como alguien que lee y escribe. Con 0 contesta
# enseguida (igual nunca corre dos respuestas a la vez para la misma persona).
IG_DEBOUNCE_MS=20000
# Tope de espera contado desde el primer mensaje sin responder: si la persona
# sigue escribiendo cada pocos segundos, a lo sumo espera esto antes de
# contestar con todo lo que haya.
IG_DEBOUNCE_MAX_MS=60000
# Máximo de autos (texto + foto) por respuesta
IG_MAX_CARS=3
# ── Barrido de rescate ────────────────────────────────────────────
# Durante el turno del bot revisa las conversaciones y contesta las que quedaron
# sin respuesta en el turno de Patricia.
IG_RESCUE_ENABLED=true
# En true pasa a simulacro: loguea a quién le contestaría sin enviar nada (debug)
IG_RESCUE_DRY_RUN=false
# El primer barrido sale apenas arranca el turno del bot (23:00); después, cada
# tantos minutos mientras dure el turno.
IG_RESCUE_INTERVAL_MIN=60
# No toca nada más fresco que esto (para no pisar una respuesta en curso)
IG_RESCUE_MIN_AGE_MIN=15
# Tope de antigüedad. Meta solo deja escribir dentro de las 24hs del último
# mensaje del cliente: más viejo que esto lo contesta Patricia a mano.
IG_RESCUE_MAX_AGE_H=20
# Máximo de conversaciones por barrido y pausa entre una y otra
IG_RESCUE_MAX_CONV=15
IG_RESCUE_GAP_MS=45000
# Token para disparar el barrido a mano: POST /admin/ig-rescue con header x-rescue-token
IG_RESCUE_TOKEN=
# Solo si el barrido aborta diciendo que ningún mensaje figura como nuestro:
# el IGSID de la cuenta de Instagram del negocio.
IG_ACCOUNT_ID=
